    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "playwright": "1.56.1",
    "prettier": "^3.9.6",
    "tw-animate-css": "^1.4.0",
